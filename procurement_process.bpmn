<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Procurement" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Codex" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Procurement">
    <bpmn:participant id="Participant_Company" name="Процесс закупки" processRef="Process_Procurement" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Procurement" name="Закупка товаров и услуг" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Initiator" name="Инициатор">
        <bpmn:flowNodeRef>StartEvent_Need</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Clarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Conformity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Received</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Руководитель / Финансы">
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Paid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Отдел закупок">
        <bpmn:flowNodeRef>Task_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RFQ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Monitor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Documents</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Need" name="Возникла потребность">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Request" name="Сформировать заявку на закупку">
      <bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_Clarified</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Check" name="Проверить заявку и спецификацию">
      <bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Complete" name="Данные полные?">
      <bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_NoComplete</bpmn:outgoing><bpmn:outgoing>Flow_Complete</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Clarify" name="Уточнить заявку">
      <bpmn:incoming>Flow_NoComplete</bpmn:incoming><bpmn:outgoing>Flow_Clarified</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Approve" name="Согласовать бюджет и закупку">
      <bpmn:incoming>Flow_Complete</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Согласовано?">
      <bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_Rejected</bpmn:outgoing><bpmn:outgoing>Flow_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Rejected" name="Заявка отклонена"><bpmn:incoming>Flow_Rejected</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Task_RFQ" name="Запросить предложения поставщиков">
      <bpmn:incoming>Flow_Approved</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Evaluate" name="Сравнить предложения и выбрать поставщика">
      <bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Contract" name="Согласовать договор">
      <bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Order" name="Разместить заказ">
      <bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Monitor" name="Контролировать срок поставки">
      <bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_Reorder</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Accept" name="Принять товар / услугу">
      <bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Conformity" name="Соответствует требованиям?">
      <bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_Nonconform</bpmn:outgoing><bpmn:outgoing>Flow_Conform</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Claim" name="Оформить претензию / возврат">
      <bpmn:incoming>Flow_Nonconform</bpmn:incoming><bpmn:outgoing>Flow_Reorder</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Documents" name="Получить закрывающие документы">
      <bpmn:incoming>Flow_Conform</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Pay" name="Проверить документы и оплатить">
      <bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Paid" name="Закупка завершена">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Received" name="Поставка принята" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Need" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Request" targetRef="Task_Check" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Check" targetRef="Gateway_Complete" />
    <bpmn:sequenceFlow id="Flow_NoComplete" name="Нет" sourceRef="Gateway_Complete" targetRef="Task_Clarify" />
    <bpmn:sequenceFlow id="Flow_Clarified" sourceRef="Task_Clarify" targetRef="Task_Request" />
    <bpmn:sequenceFlow id="Flow_Complete" name="Да" sourceRef="Gateway_Complete" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Approve" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Rejected" name="Нет" sourceRef="Gateway_Approved" targetRef="EndEvent_Rejected" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Да" sourceRef="Gateway_Approved" targetRef="Task_RFQ" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_RFQ" targetRef="Task_Evaluate" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Evaluate" targetRef="Task_Contract" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Contract" targetRef="Task_Order" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Order" targetRef="Task_Monitor" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Monitor" targetRef="Task_Accept" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Accept" targetRef="Gateway_Conformity" />
    <bpmn:sequenceFlow id="Flow_Nonconform" name="Нет" sourceRef="Gateway_Conformity" targetRef="Task_Claim" />
    <bpmn:sequenceFlow id="Flow_Reorder" sourceRef="Task_Claim" targetRef="Task_Monitor" />
    <bpmn:sequenceFlow id="Flow_Conform" name="Да" sourceRef="Gateway_Conformity" targetRef="Task_Documents" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Documents" targetRef="Task_Pay" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Pay" targetRef="EndEvent_Paid" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Procurement">
    <bpmndi:BPMNPlane id="BPMNPlane_Procurement" bpmnElement="Collaboration_Procurement">
      <bpmndi:BPMNShape id="Participant_Company_di" bpmnElement="Participant_Company" isHorizontal="true"><dc:Bounds x="100" y="80" width="1900" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Initiator_di" bpmnElement="Lane_Initiator" isHorizontal="true"><dc:Bounds x="130" y="80" width="1870" height="190" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true"><dc:Bounds x="130" y="270" width="1870" height="170" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Procurement_di" bpmnElement="Lane_Procurement" isHorizontal="true"><dc:Bounds x="130" y="440" width="1870" height="240" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Need_di" bpmnElement="StartEvent_Need"><dc:Bounds x="180" y="150" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Request_di" bpmnElement="Task_Request"><dc:Bounds x="260" y="128" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Check_di" bpmnElement="Task_Check"><dc:Bounds x="430" y="490" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Complete_di" bpmnElement="Gateway_Complete" isMarkerVisible="true"><dc:Bounds x="600" y="505" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Clarify_di" bpmnElement="Task_Clarify"><dc:Bounds x="580" y="150" width="100" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve"><dc:Bounds x="710" y="315" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved" isMarkerVisible="true"><dc:Bounds x="870" y="330" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Rejected_di" bpmnElement="EndEvent_Rejected"><dc:Bounds x="880" y="400" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RFQ_di" bpmnElement="Task_RFQ"><dc:Bounds x="960" y="490" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Evaluate_di" bpmnElement="Task_Evaluate"><dc:Bounds x="1120" y="490" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Contract_di" bpmnElement="Task_Contract"><dc:Bounds x="1290" y="490" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Order_di" bpmnElement="Task_Order"><dc:Bounds x="1450" y="490" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Monitor_di" bpmnElement="Task_Monitor"><dc:Bounds x="1600" y="490" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Accept_di" bpmnElement="Task_Accept"><dc:Bounds x="1600" y="150" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Conformity_di" bpmnElement="Gateway_Conformity" isMarkerVisible="true"><dc:Bounds x="1760" y="165" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Claim_di" bpmnElement="Task_Claim"><dc:Bounds x="1740" y="490" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Documents_di" bpmnElement="Task_Documents"><dc:Bounds x="1840" y="570" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Pay_di" bpmnElement="Task_Pay"><dc:Bounds x="1840" y="315" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Paid_di" bpmnElement="EndEvent_Paid"><dc:Bounds x="1970" y="337" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="216" y="168" /><di:waypoint x="260" y="168" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="380" y="168" /><di:waypoint x="405" y="168" /><di:waypoint x="405" y="530" /><di:waypoint x="430" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="550" y="530" /><di:waypoint x="600" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_NoComplete_di" bpmnElement="Flow_NoComplete"><di:waypoint x="625" y="505" /><di:waypoint x="625" y="220" /><bpmndi:BPMNLabel><dc:Bounds x="630" y="360" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Clarified_di" bpmnElement="Flow_Clarified"><di:waypoint x="580" y="185" /><di:waypoint x="380" y="185" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Complete_di" bpmnElement="Flow_Complete"><di:waypoint x="650" y="530" /><di:waypoint x="680" y="530" /><di:waypoint x="680" y="355" /><di:waypoint x="710" y="355" /><bpmndi:BPMNLabel><dc:Bounds x="665" y="440" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="830" y="355" /><di:waypoint x="870" y="355" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_di" bpmnElement="Flow_Rejected"><di:waypoint x="895" y="380" /><di:waypoint x="898" y="400" /><bpmndi:BPMNLabel><dc:Bounds x="900" y="385" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_di" bpmnElement="Flow_Approved"><di:waypoint x="920" y="355" /><di:waypoint x="940" y="355" /><di:waypoint x="940" y="530" /><di:waypoint x="960" y="530" /><bpmndi:BPMNLabel><dc:Bounds x="925" y="435" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1080" y="530" /><di:waypoint x="1120" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1250" y="530" /><di:waypoint x="1290" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1410" y="530" /><di:waypoint x="1450" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1560" y="530" /><di:waypoint x="1600" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="1660" y="490" /><di:waypoint x="1660" y="230" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1720" y="190" /><di:waypoint x="1760" y="190" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Nonconform_di" bpmnElement="Flow_Nonconform"><di:waypoint x="1785" y="215" /><di:waypoint x="1785" y="490" /><bpmndi:BPMNLabel><dc:Bounds x="1790" y="350" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Reorder_di" bpmnElement="Flow_Reorder"><di:waypoint x="1740" y="530" /><di:waypoint x="1720" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Conform_di" bpmnElement="Flow_Conform"><di:waypoint x="1810" y="190" /><di:waypoint x="1900" y="190" /><di:waypoint x="1900" y="570" /><bpmndi:BPMNLabel><dc:Bounds x="1860" y="180" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1900" y="570" /><di:waypoint x="1900" y="395" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1960" y="355" /><di:waypoint x="1970" y="355" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
